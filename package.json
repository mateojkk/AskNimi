{
  "name": "asknim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AskNim — your pocket AI inside Nimiq Pay. Pennies per question, paid in feeless NIM.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "groq-sdk": "^1.6.0",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}

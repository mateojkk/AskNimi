# ── AskNim server configuration ──────────────────────────────
# Groq (https://console.groq.com/keys) — required for real AI answers.
# Without a key the server runs an echo bot so the plumbing can be tested.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Where paid credits go — your Nimiq wallet address (user-friendly format)
MERCHANT_NIM_ADDRESS=NQ07 0000 0000 0000 0000 0000 0000 0000 0000

# Nimiq JSON-RPC endpoint used to verify incoming payments.
# Open community server is fine for development; run your own node for production.
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# HTTP port for the API server
PORT=8787

# How many AI messages a brand-new device gets for free (onboarding)
FREE_MESSAGES=3
